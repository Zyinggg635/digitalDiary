<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="search.SearchController">

    <children>
        <VBox spacing="10" alignment="CENTER" AnchorPane.topAnchor="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <Label text="Search Diary Entries" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <TextField fx:id="searchField" promptText="Enter keyword" />
            <Button text="Search" onAction="#handleSearch" />
            <ListView fx:id="resultsListView" />
            <Button text="Back" onAction="#handleBack" />
        </VBox>
    </children>
</AnchorPane>
    
